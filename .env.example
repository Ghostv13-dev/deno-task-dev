# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Telegram numeric user ID of the owner (get from @userinfobot)
OWNER_ID=123456789

# Secret path segment used to validate incoming webhook requests from Telegram
WEBHOOK_SECRET=change-this-to-a-long-random-string

# Public HTTPS base URL of this deployment (e.g. https://bot.yourdomain.com)
PUBLIC_URL=https://bot.yourdomain.com

# Path to the SQLite database file (must be on persistent, writable storage)
DB_PATH=./data/bot.db
